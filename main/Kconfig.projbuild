menu "MicroPaw"

config MICROPAW_TELEGRAM
    bool "Telegram channel"
    default y

config MICROPAW_WEB_SEARCH
    bool "DuckDuckGo Lite search"
    default y

config MICROPAW_WEB_FETCH
    bool "Bounded result-page fetch"
    depends on MICROPAW_WEB_SEARCH
    default y

config MICROPAW_WIKIPEDIA
    bool "Wikipedia search source"
    depends on MICROPAW_WEB_SEARCH
    default y

config MICROPAW_ARXIV
    bool "arXiv search source"
    depends on MICROPAW_WEB_SEARCH
    default y

config MICROPAW_RSS
    bool "RSS and Atom reader"
    default y

config MICROPAW_GMAIL
    bool "Gmail send tool"
    default y

config MICROPAW_CALENDAR
    bool "Google Calendar create tool"
    default y

config MICROPAW_LLM_MODEL
    string "Default LLM model"
    default "gpt-5.6-luna"

config MICROPAW_MAX_TOOL_ROUNDS
    int "Maximum tool rounds"
    range 1 8
    default 4

config MICROPAW_LLM_STREAM_LIMIT
    int "Inference stream byte limit"
    range 32768 262144
    default 131072

config MICROPAW_AGENT_STACK
    int "Agent task stack bytes"
    range 8192 32768
    default 16384

config MICROPAW_TELEGRAM_STACK
    int "Telegram task stack bytes"
    range 4096 16384
    default 8192

config MICROPAW_SCHEDULER_STACK
    int "Scheduler task stack bytes"
    range 3072 8192
    default 4096

config MICROPAW_CLI_STACK
    int "Serial console task stack bytes"
    range 3072 8192
    default 4096

config MICROPAW_SEARCH_DOWNLOAD_LIMIT
    int "Search response byte limit"
    range 16384 98304
    default 49152

config MICROPAW_PAGE_DOWNLOAD_LIMIT
    int "Fetched page byte limit"
    range 8192 131072
    default 32768

endmenu
